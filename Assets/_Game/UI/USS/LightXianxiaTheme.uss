* {
    -unity-font-definition: resource("RemakeFontSDF");
    color: #1F2B29;
}

.full-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* =========================================================
   LIGHT SUNLIT XIANXIA SURFACES (Bạch Ngọc / Giấy Tuyên Sáng)
   ========================================================= */
.panel-light {
    background-image: resource("BakedMaps/hud_panel_light_9slice");
    -unity-slice-scale: 0.20;
    background-color: transparent;
    border-width: 0;
    padding: 14px;
}

.panel-compact {
    background-color: rgba(247, 243, 232, 0.95);
    border-width: 1.5px;
    border-color: #C89B3C;
    border-radius: 13px;
}

.card-light {
    background-image: resource("BakedMaps/hud_card_light_9slice");
    -unity-slice-scale: 0.16;
    background-color: transparent;
    border-width: 0;
    padding: 12px 14px;
}

.pill-light {
    background-color: rgba(248, 245, 236, 0.90);
    border-width: 1.5px;
    border-color: rgba(200, 155, 60, 0.65);
    border-radius: 999px;
    padding: 4px 10px;
    flex-direction: row;
    align-items: center;
}

.text-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: #182725;
}

.text-section {
    font-size: 14px;
    -unity-font-style: bold;
    color: #1B745C;
}

.text-body {
    font-size: 12px;
    color: #2A3A37;
}

.text-muted {
    font-size: 11px;
    color: #5A6E6A;
}

.text-gold {
    color: #A06D10;
    -unity-font-style: bold;
}

.text-danger {
    color: #B83226;
    -unity-font-style: bold;
}

/* =========================================================
   BUTTONS
   ========================================================= */
.btn-primary {
    background-image: resource("BakedMaps/hud_btn_primary_9slice");
    -unity-slice-scale: 0.22;
    background-color: transparent;
    border-width: 0;
    padding: 9px 26px;
    min-width: 118px;
    color: #4A2703;
    -unity-font-style: bold;
    font-size: 13px;
    -unity-text-align: middle-center;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.btn-primary:hover {
    -unity-background-image-tint-color: #FFF4D4;
}

.btn-primary:active {
    scale: 0.96 0.96;
}

.btn-secondary {
    background-image: resource("BakedMaps/hud_btn_secondary_9slice");
    -unity-slice-scale: 0.20;
    background-color: transparent;
    border-width: 0;
    padding: 7px 20px;
    min-width: 88px;
    color: #12483A;
    -unity-font-style: bold;
    font-size: 12px;
    -unity-text-align: middle-center;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.btn-secondary:hover {
    -unity-background-image-tint-color: #ECFAF4;
}

.btn-secondary:active {
    scale: 0.96 0.96;
}

.btn-secondary.selected {
    -unity-background-image-tint-color: #7ED4B4;
    color: #07291F;
}

.btn-compact {
    background-color: #DDF0E7;
    border-width: 1.5px;
    border-color: #26876F;
    border-radius: 9px;
    padding: 4px 10px;
    color: #165B4A;
    -unity-font-style: bold;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.btn-compact:hover {
    background-color: #CCE7DB;
}

.btn-compact:active {
    scale: 0.95 0.95;
}

.btn-compact.selected {
    background-color: #22886F;
    color: #FFFFFF;
    border-color: #155948;
}

.btn-danger {
    background-color: #FBE6E4;
    border-width: 1.5px;
    border-color: #C94A38;
    border-radius: 10px;
    padding: 7px 12px;
    color: #9F291B;
    -unity-font-style: bold;
    font-size: 12px;
}

/* =========================================================
   CODEX ART PLACEHOLDERS (NEVER USE EMOJI / VECTOR TEXT)
   ========================================================= */
.art-slot {
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.art-slot-cover {
    background-size: cover;
    background-position: center;
}

.art-slot-placeholder {
    background-color: #E7F1EA;
    border-width: 1px;
    border-color: rgba(34, 136, 111, 0.55);
    border-radius: 12px;
    overflow: hidden;
}

.art-placeholder-text {
    font-size: 7px;
    -unity-font-style: bold;
    color: #1E6D59;
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 1px;
}

/* =========================================================
   CIRCULAR HUD BUTTONS (56px TOUCH TARGETS)
   ========================================================= */
.circle-btn-wrap {
    width: 62px;
    align-items: center;
    margin: 3px;
    transition-property: scale, opacity;
    transition-duration: 0.16s;
}

.circle-btn {
    width: 58px;
    height: 58px;
    background-image: resource("CodexDrop/HUD/hud_circle_btn_idle");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding: 9px;
    transition-property: scale;
    transition-duration: 0.12s;
}

.circle-btn:hover,
.circle-btn.active {
    background-image: resource("CodexDrop/HUD/hud_circle_btn_active");
}

.circle-btn:active {
    scale: 0.93 0.93;
}

.circle-btn.locked {
    background-image: resource("CodexDrop/HUD/hud_circle_btn_locked");
    background-color: transparent;
    border-width: 0;
    opacity: 0.92;
}

.circle-btn.locked .circle-btn-icon {
    opacity: 0.42;
}

.circle-btn-icon {
    width: 38px;
    height: 38px;
    border-radius: 19px;
}

.circle-btn-label {
    margin-top: 2px;
    font-size: 10px;
    -unity-font-style: bold;
    color: #1E2E2B;
    background-color: rgba(250, 247, 238, 0.82);
    border-radius: 6px;
    padding: 1px 4px;
    -unity-text-align: middle-center;
}

.hud-camera-button {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    padding: 7px;
}

.hud-camera-icon {
    width: 27px;
    height: 27px;
}

.hud-mini-camera-button {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    padding: 5px;
}

.hud-mini-camera-icon {
    width: 22px;
    height: 22px;
}

.badge-dot {
    position: absolute;
    right: 2px;
    top: 2px;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: #D83B2D;
    border-width: 1.5px;
    border-color: #FFFFFF;
}

.badge-dot.hud-quest-reward-dot {
    right: 5px;
    top: 5px;
}

/* =========================================================
   HUD ROOT & RESPONSIVE BREAKPOINTS (MOBILE / WEB / MINI)
   ========================================================= */
.hud-root {
    justify-content: space-between;
}

.hud-top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
}

.hud-middle-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    flex-grow: 1;
    margin-top: 6px;
}

.hud-bottom-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    width: 100%;
}

.cluster-panel {
    background-image: resource("BakedMaps/hud_panel_light_9slice");
    -unity-slice-scale: 0.16;
    background-color: transparent;
    border-width: 0;
    padding: 12px;
}

.cluster-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 210px;
    justify-content: flex-end;
}

.mini-mode .hide-in-mini {
    display: none;
}

.mini-pill-bar {
    display: none;
}

.mini-mode .mini-pill-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(248, 245, 236, 0.93);
    border-width: 1.5px;
    border-color: #C89B3C;
    border-radius: 14px;
    padding: 6px 10px;
    width: 100%;
}

/* =========================================================
   DRAWER / MODAL BACKDROP & SHEET
   ========================================================= */
.drawer-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(24, 38, 35, 0.34);
    align-items: center;
    justify-content: center;
    padding: 14px;
}

.drawer-sheet {
    width: 100%;
    max-width: 492px;
    max-height: 86%;
    -unity-slice-scale: 0.24;
    padding: 18px 20px;
}

.desktop-wide .drawer-sheet {
    max-width: 640px;
}

.bar-track {
    height: 7px;
    border-radius: 4px;
    background-color: #DCE5DF;
    overflow: hidden;
}

.bar-fill-hp {
    height: 100%;
    background-color: #2FA86E;
}

.bar-fill-mp {
    height: 100%;
    background-color: #3B8FD4;
}

.bar-fill-tuvi {
    height: 100%;
    background-color: #DFA12A;
}

.bar-fill-boss {
    height: 100%;
    background-color: #D9483B;
}

.fps-good { color: #197B56; -unity-font-style: bold; }
.fps-warn { color: #B4740C; -unity-font-style: bold; }
.fps-low { color: #C0352B; -unity-font-style: bold; }

/* =========================================================
   TUTORIAL POINTER HIGHLIGHT RING
   ========================================================= */
.tutorial-pointer-box {
    position: absolute;
    border-width: 3px;
    border-color: #E59B1A;
    border-radius: 32px;
    background-color: rgba(255, 224, 130, 0.14);
}

.tutorial-tip-pill {
    position: absolute;
    background-color: #FFF9E6;
    border-width: 2px;
    border-color: #D48D15;
    border-radius: 12px;
    padding: 5px 10px;
    font-size: 12px;
    -unity-font-style: bold;
    color: #5D3C04;
}

.damage-popup-label {
    position: absolute;
    font-size: 15px;
    -unity-font-style: bold;
    color: #1F2B29;
    background-color: rgba(255, 253, 246, 0.72);
    border-radius: 8px;
    padding: 1px 5px;
}

.damage-popup-crit {
    font-size: 19px;
    color: #C73E1D;
    background-color: rgba(255, 245, 214, 0.90);
}

/* =========================================================
   V2 STAGES, PAPERDOLL, COMPARISON & COMING SOON BADGES
   ========================================================= */
.stage-hero-box {
    background-color: rgba(255, 252, 244, 0.94);
    border-width: 1.5px;
    border-color: rgba(200, 155, 60, 0.72);
    border-radius: 14px;
    padding: 10px;
    margin-bottom: 8px;
    align-items: center;
}

.stat-up {
    color: #167D52;
    -unity-font-style: bold;
}

.stat-down {
    color: #C73E1D;
    -unity-font-style: bold;
}

.coming-soon-badge {
    background-color: #D98E1F;
    color: #FFFFFF;
    border-radius: 6px;
    padding: 2px 7px;
    font-size: 9px;
    -unity-font-style: bold;
}

.ky-ngo-orb-btn {
    width: 54px;
    height: 54px;
    border-radius: 27px;
    background-color: rgba(255, 250, 232, 0.95);
    border-width: 2.5px;
    border-color: #E2A220;
    align-items: center;
    justify-content: center;
    padding: 0;
}

/* =========================================================
   JUICY NOTIFICATION BANNERS, RED ! BADGE, GRIDS & TRIBULATION
   ========================================================= */
.toast-stack {
    width: 92%;
    max-width: 440px;
    align-items: center;
}

.toast-banner {
    flex-direction: row;
    align-items: center;
    max-width: 100%;
    padding: 7px 13px;
    margin-bottom: 5px;
    border-radius: 13px;
    border-width: 2px;
    transition-property: scale, opacity;
    transition-duration: 0.16s;
}

.toast-gold {
    background-color: rgba(255, 249, 226, 0.98);
    border-color: #D89416;
}

.toast-jade {
    background-color: rgba(238, 252, 245, 0.98);
    border-color: #1F8A6B;
}

.toast-danger {
    background-color: rgba(255, 240, 238, 0.98);
    border-color: #D13D2E;
}

.toast-tag {
    border-radius: 6px;
    padding: 2px 6px;
    margin-right: 7px;
    font-size: 9px;
    -unity-font-style: bold;
    color: #FFFFFF;
    flex-shrink: 0;
}

.toast-gold .toast-tag {
    background-color: #D18710;
}

.toast-jade .toast-tag {
    background-color: #1A7F62;
}

.toast-danger .toast-tag {
    background-color: #C83425;
}

.toast-msg {
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
    flex-shrink: 1;
}

.toast-gold .toast-msg {
    color: #6B3F03;
}

.toast-jade .toast-msg {
    color: #104939;
}

.toast-danger .toast-msg {
    color: #8A1E14;
}

.alert-bang-badge {
    position: absolute;
    right: -3px;
    top: -3px;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: #E02B1E;
    border-width: 2px;
    border-color: #FFFFFF;
    color: #FFFFFF;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
}

.hud-collapse-pill {
    background-color: rgba(248, 244, 233, 0.94);
    border-width: 1.5px;
    border-color: #C89B3C;
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 10px;
    -unity-font-style: bold;
    color: #1B5E4A;
    margin-bottom: 5px;
}

.tribulation-hud-panel {
    background-color: rgba(255, 249, 230, 0.97);
    border-width: 2.5px;
    border-color: #D98E14;
    border-radius: 14px;
    padding: 8px 14px;
    width: 288px;
    max-width: 92%;
    align-self: center;
    margin-top: 4px;
}

.bar-fill-tribulation {
    height: 100%;
    background-color: #8A46D9;
}

.bar-fill-alchemy {
    height: 100%;
    background-color: #E07D1E;
}

.grid-wrap {
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
    align-items: flex-start;
}

.icon-fixed {
    flex-shrink: 0;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.grid-tile {
    background-color: rgba(253, 250, 242, 0.96);
    border-width: 1.5px;
    border-color: rgba(190, 165, 110, 0.65);
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    padding: 4px;
    margin: 0;
    overflow: hidden;
}

.grid-tile-selected {
    background-color: rgba(255, 246, 214, 0.98);
    border-width: 2.5px;
    border-color: #D89416;
}

.fifa-main-slot {
    width: 78px;
    height: 84px;
    background-color: rgba(255, 246, 216, 0.98);
    border-width: 2.5px;
    border-color: #D98D14;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    padding: 3px;
    margin: 0;
    overflow: visible;
}

.fifa-fodder-slot {
    width: 60px;
    height: 72px;
    background-color: rgba(242, 248, 244, 0.95);
    border-width: 1.5px;
    border-color: #469982;
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    margin: 0 4px 4px 0;
    padding: 3px;
    overflow: visible;
}

.rarity-halo-outer {
    position: absolute;
    left: -3px;
    right: -3px;
    top: -3px;
    bottom: -3px;
    border-radius: 12px;
    border-width: 2.5px;
}

.rarity-halo-inner {
    position: absolute;
    left: 1px;
    right: 1px;
    top: 1px;
    bottom: 1px;
    border-radius: 8px;
    border-width: 1px;
}

.fifa-fodder-slot-empty {
    background-color: rgba(235, 240, 237, 0.72);
    border-color: rgba(130, 155, 146, 0.65);
}

.dao-chip-btn {
    background-color: #DDF0E7;
    border-width: 1.5px;
    border-color: #26876F;
    border-radius: 9px;
    padding: 4px 10px;
    margin: 0 5px 5px 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.dao-chip-btn.selected {
    background-color: #22886F;
    border-color: #155948;
}

.dao-chip-btn.selected Label {
    color: #FFFFFF;
}

/* =========================================================
   WEB PC / LAPTOP HORIZONTAL LANDSCAPE LAYOUT (16:9)
   ========================================================= */
.menu-card {
    width: 396px;
    max-width: 94%;
    padding: 24px 22px;
    align-items: center;
}

.menu-card-body {
    width: 100%;
    flex-direction: column;
    align-items: center;
}

.menu-brand-col {
    width: 100%;
    align-items: center;
    justify-content: center;
}

.menu-form-col {
    width: 100%;
    align-items: stretch;
}

.desktop-wide .menu-card {
    width: 820px;
    max-width: 90%;
    padding: 26px 28px;
}

.desktop-wide .menu-card-body {
    flex-direction: row;
    align-items: center;
}

.desktop-wide .menu-brand-col {
    width: 40%;
    margin-right: 22px;
    padding-right: 18px;
    border-right-width: 1.5px;
    border-right-color: rgba(200, 155, 60, 0.35);
}

.desktop-wide .menu-form-col {
    width: 58%;
    flex-grow: 1;
}

.hud-top-left-wrap {
    flex-direction: column;
    align-items: flex-start;
}

.desktop-wide .hud-top-left-wrap {
    flex-direction: row;
    align-items: center;
}

.desktop-wide .hud-breakthrough-wrap {
    margin-top: 0;
    margin-left: 10px;
}

.desktop-wide #cluster-utility-drawer {
    flex-direction: row;
    padding: 8px 10px;
}

.desktop-wide .hud-cultivation-dock {
    flex-direction: row;
    align-items: flex-end;
}

.desktop-wide #cluster-cultivation-drawer {
    margin-bottom: 0;
    margin-right: 8px;
    padding: 8px 10px;
}

.desktop-wide .cluster-grid {
    width: auto;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-end;
}

.desktop-wide .drawer-sheet {
    width: 92%;
    max-width: 960px;
    max-height: 86%;
    padding: 18px 22px;
}

.pc-split-row {
    flex-direction: column;
    width: 100%;
}

.pc-split-left {
    width: 100%;
}

.pc-split-right {
    width: 100%;
}

.desktop-wide .pc-split-row {
    flex-direction: row;
    align-items: flex-start;
}

.desktop-wide .pc-split-left {
    width: 45%;
    flex-shrink: 0;
    margin-right: 14px;
}

.desktop-wide .pc-split-right {
    width: 53%;
    flex-grow: 1;
    flex-shrink: 1;
}

.pc-hotkey-badge {
    display: none;
    position: absolute;
    left: -2px;
    top: -2px;
    background-color: rgba(24, 39, 37, 0.85);
    color: #FFF7D6;
    font-size: 9px;
    -unity-font-style: bold;
    border-radius: 5px;
    padding: 1px 4px;
    border-width: 1px;
    border-color: rgba(212, 162, 52, 0.8);
}

.desktop-wide .pc-hotkey-badge {
    display: flex;
}

/* =========================================================
   CLEAN TOP HUD HEADER (ZERO OVERLAP PORTRAIT + LANDSCAPE)
   ========================================================= */
.hud-header-stack {
    width: 100%;
    flex-direction: column;
    position: relative;
}

.hud-avatar-host {
    width: 54px;
    height: 54px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.hud-avatar-portrait {
    width: 38px;
    height: 38px;
    border-radius: 19px;
    background-color: #FFFDF8;
}

.desktop-wide .hud-avatar-host {
    width: 60px;
    height: 60px;
}

.desktop-wide .hud-avatar-portrait {
    width: 42px;
    height: 42px;
    border-radius: 21px;
}

.hud-hero-card {
    margin-left: 5px;
    padding: 4px 8px;
    min-width: 118px;
    max-width: 158px;
    justify-content: center;
}

.desktop-wide .hud-hero-card {
    min-width: 146px;
    max-width: 196px;
    padding: 5px 10px;
}

.hud-hero-name {
    font-size: 12px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.hud-hero-realm {
    font-size: 10px;
    margin: 1px 0 0 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.hud-top-right-wrap {
    align-items: flex-end;
    flex-shrink: 0;
}

.hud-currency-pill {
    margin-right: 4px;
    padding: 3px 9px;
    min-height: 24px;
}

.hud-fps-pill {
    margin-right: 4px;
    padding: 2px 8px;
    min-height: 20px;
}

.hud-stage-center-wrap {
    align-items: center;
    justify-content: center;
    margin-top: 6px;
    width: 100%;
}

.hud-stage-pill {
    padding: 4px 12px;
    border-color: rgba(200, 155, 60, 0.85);
}

.desktop-wide .hud-stage-center-wrap {
    position: absolute;
    left: 255px;
    right: 235px;
    top: 3px;
    width: auto;
    margin-top: 0;
}

.hud-breakthrough-wrap {
    position: absolute;
    left: 2px;
    top: 60px;
    margin: 0;
    width: auto;
    flex-direction: row;
    align-items: center;
}

.desktop-wide .hud-breakthrough-wrap {
    position: relative;
    left: 0;
    top: 0;
    margin-top: 0;
    margin-left: 8px;
    width: 56px;
    flex-direction: column;
}

/* =========================================================
   RESPAWN COUNTDOWN BANNER (LIGHT CRIMSON XIANXIA)
   ========================================================= */
.respawn-hud-panel {
    background-color: rgba(255, 245, 242, 0.97);
    border-width: 2px;
    border-color: #C94A38;
    border-radius: 14px;
    padding: 8px 14px;
    width: 296px;
    max-width: 92%;
    align-self: center;
    margin-top: 5px;
}

.bar-fill-respawn {
    height: 100%;
    background-color: #D9483B;
}

/* =========================================================
   WIDER MODAL SHEET & REDESIGNED NHAT KY TIEN LO (PIONEER DIARY)
   ========================================================= */
.drawer-sheet-wide {
    width: 98%;
    max-width: 530px;
    max-height: 90%;
    padding: 15px 16px;
}

.desktop-wide .drawer-sheet-wide {
    width: 95%;
    max-width: 1060px;
    max-height: 90%;
    padding: 18px 24px;
}

.diary-hero-banner {
    background-color: rgba(255, 252, 242, 0.97);
    border-width: 2px;
    border-color: #D29A2B;
    border-radius: 16px;
    padding: 12px 14px;
    margin-bottom: 10px;
}

.diary-stepper-track {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
    padding: 6px 4px 2px 4px;
}

.diary-step-node {
    align-items: center;
    flex-grow: 1;
}

.diary-step-dot {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    border-width: 2px;
    border-color: #C4B89B;
    background-color: #F4EFE2;
    align-items: center;
    justify-content: center;
}

.diary-step-dot.done {
    background-color: #1F8A6B;
    border-color: #14634C;
}

.diary-step-dot.ready {
    background-color: #E5A11A;
    border-color: #9E6304;
}

.diary-step-dot.active {
    background-color: #FFF7DF;
    border-color: #D98E14;
    border-width: 2.5px;
}

.diary-spotlight {
    background-color: rgba(255, 248, 224, 0.98);
    border-width: 2px;
    border-color: #DA981A;
    border-radius: 16px;
    padding: 12px 14px;
    margin-bottom: 12px;
}

.diary-card {
    width: 100%;
    background-color: rgba(253, 250, 242, 0.97);
    border-width: 1.5px;
    border-color: rgba(196, 165, 102, 0.72);
    border-radius: 14px;
    padding: 10px 12px;
    margin-bottom: 8px;
    overflow: hidden;
}

.desktop-wide .diary-card {
    width: 49%;
}

.diary-card.ready {
    background-color: rgba(255, 249, 228, 0.99);
    border-width: 2px;
    border-color: #DF9918;
}

.diary-card.claimed {
    background-color: rgba(240, 249, 244, 0.92);
    border-color: rgba(45, 148, 114, 0.60);
}

.diary-status-badge {
    border-radius: 999px;
    padding: 2px 8px;
    font-size: 9px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.diary-status-badge.done {
    background-color: #D4F1E5;
    color: #11624A;
}

.diary-status-badge.ready {
    background-color: #FBE4A4;
    color: #7D4902;
}

.diary-status-badge.active {
    background-color: #DFF0FA;
    color: #165985;
}

.diary-status-badge.locked {
    background-color: #E8E6DC;
    color: #6A7570;
}

.reward-chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(247, 243, 232, 0.95);
    border-width: 1px;
    border-color: rgba(198, 162, 88, 0.55);
    border-radius: 8px;
    padding: 2px 6px;
    margin-right: 5px;
    margin-bottom: 4px;
}

.btn-danger {
    background-color: #C94436;
    color: #FFFFFF;
    border-width: 1.5px;
    border-color: #93271D;
    border-radius: 11px;
    -unity-font-style: bold;
    font-size: 12px;
    padding: 6px 12px;
}

.btn-danger:hover {
    background-color: #B4372A;
}

.desktop-wide #cs-main-panel {
    max-width: 460px;
    align-self: flex-end;
    margin-right: 12px;
}

/* =========================================================
   CHARACTER SELECT 2D SHOWCASE & FLOATING UTILITY DRAWER
   ========================================================= */
.cs-2d-showcase-ring {
    width: 214px;
    height: 214px;
    border-radius: 107px;
    border-width: 3px;
    border-color: rgba(212, 162, 52, 0.92);
    background-color: rgba(255, 252, 244, 0.92);
    align-items: center;
    justify-content: center;
    padding: 8px;
}

.cs-2d-showcase-ring.compact {
    width: 152px;
    height: 152px;
    border-radius: 76px;
    padding: 6px;
}

.cs-2d-showcase-art {
    width: 100%;
    height: 100%;
    border-radius: 999px;
}

.hud-profile-trigger {
    border-radius: 14px;
}

.hud-profile-trigger:hover .hud-hero-card {
    border-color: #D89B22;
    background-color: rgba(255, 252, 240, 0.99);
}

.utility-floating-drawer {
    position: absolute;
    right: 8px;
    top: 86px;
    width: 158px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 8px 6px 4px 8px;
}

.desktop-wide .utility-floating-drawer {
    right: 12px;
    top: 84px;
    width: auto;
    flex-direction: row;
    flex-wrap: nowrap;
    padding: 8px 10px;
}
