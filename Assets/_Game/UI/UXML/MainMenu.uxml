<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../USS/LightXianxiaTheme.uss" />

    <ui:VisualElement name="menu-root" class="full-screen" style="background-color: #DDF2FF; align-items: center; justify-content: center; padding: 18px;">
        <!-- Codex Daylight Menu Wallpaper Slot (A11) -->
        <ui:VisualElement name="menu-bg-slot" class="full-screen art-slot art-slot-cover" style="opacity: 0.92;" />

        <!-- Top Quick Graphics / FPS Corner -->
        <ui:VisualElement style="position: absolute; top: 14px; right: 14px; flex-direction: row; align-items: center;">
            <ui:VisualElement class="pill-light" style="margin-right: 8px;">
                <ui:Label name="menu-fps-label" text="60 FPS" class="text-muted fps-good" />
            </ui:VisualElement>
            <ui:Button name="btn-menu-preset" text="Đồ Họa: Trung" class="btn-compact" style="padding: 5px 10px; font-size: 11px;" />
        </ui:VisualElement>

        <!-- Center Light Xianxia Card (Portrait 1-col / PC Landscape 2-col) -->
        <ui:VisualElement name="menu-card" class="panel-light menu-card">
            <ui:VisualElement class="menu-card-body">
                <ui:VisualElement class="menu-brand-col">
                    <ui:VisualElement style="width: 96px; height: 96px; align-items: center; justify-content: center;">
                        <ui:VisualElement name="menu-portrait-slot" class="art-slot" style="width: 76px; height: 76px; border-radius: 38px; background-color: #FFFDF8;" />
                        <ui:VisualElement name="menu-avatar-frame" picking-mode="Ignore" class="full-screen art-slot" />
                    </ui:VisualElement>
                    <ui:Label text="KHÍ VẬN CHI TỬ" class="text-title" style="font-size: 34px; letter-spacing: 1px; margin-top: 6px; -unity-text-align: middle-center;" />
                    <ui:Label text="Vạn Giới Đồng Cỏ · Tu Tiên Vấn Đạo" class="font-ornament" style="font-size: 26px; color: #9A6814; margin-top: -1px; margin-bottom: 2px; -unity-text-align: middle-center;" />
                    <ui:Label text="Bản Thương Mại · Khí Vận Trường Lưu" class="text-muted" style="font-size: 11.5px; margin-top: 0; margin-bottom: 10px; -unity-text-align: middle-center;" />
                </ui:VisualElement>

                <ui:VisualElement class="menu-form-col">
                    <!-- Account Switcher (Hidden in Release Builds; Editor/Dev Only) -->
                    <ui:VisualElement name="dev-account-switcher" style="width: 100%; margin-bottom: 10px;">
                        <ui:Label text="Chế Độ Phát Triển (Editor/Dev):" class="text-muted" style="font-size: 11.5px; margin-bottom: 4px;" />
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                            <ui:Button name="btn-account-main" text="Tài Khoản Chính" class="btn-secondary" style="flex-grow: 1; margin-right: 4px; font-size: 11.5px; padding-left: 8px; padding-right: 8px;" />
                            <ui:Button name="btn-account-test" text="Tài Khoản Test Full" class="btn-secondary" style="flex-grow: 1; font-size: 11.5px; padding-left: 8px; padding-right: 8px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Active Slot Preview Card -->
                    <ui:VisualElement name="existing-save-box" class="card-light" style="width: 100%; display: none; margin-bottom: 12px;">
                        <ui:Label name="save-dao-name" text="Đạo Hữu: Thanh Vân Tử" class="text-section" style="font-size: 17px;" />
                        <ui:Label name="save-realm-info" text="Luyện Khí Tầng 1 · Ải 1-1" class="font-heading" style="font-size: 14.5px; color: #9A650B; margin-top: 3px;" />
                    </ui:VisualElement>

                    <!-- Graphics Preset Selector -->
                    <ui:VisualElement style="width: 100%; margin-bottom: 14px;">
                        <ui:Label text="Cấu Hình 3D Khởi Đầu:" class="text-muted" style="font-size: 11.5px; margin-bottom: 6px;" />
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                            <ui:Button name="btn-gfx-low" text="Thấp (iPhone)" class="btn-secondary" style="flex-grow: 1; margin-right: 4px; font-size: 11px; min-width: 76px; padding-left: 6px; padding-right: 6px;" />
                            <ui:Button name="btn-gfx-med" text="Trung (Web)" class="btn-secondary" style="flex-grow: 1; margin-right: 4px; font-size: 11px; min-width: 76px; padding-left: 6px; padding-right: 6px;" />
                            <ui:Button name="btn-gfx-high" text="Cao (PC)" class="btn-secondary" style="flex-grow: 1; font-size: 11px; min-width: 76px; padding-left: 6px; padding-right: 6px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Button name="btn-open-charselect" text="CHỌN / TẠO NHÂN VẬT (3 Ô)" class="btn-primary" style="width: 100%; height: 46px; font-size: 14px; margin-bottom: 8px;" />
                    <ui:Button name="btn-play-continue" text="TIẾP TỤC NHANH" class="btn-secondary" style="width: 100%; height: 40px; font-size: 13px; display: none; margin-bottom: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" />
                    <ui:Button name="btn-reset-remake-save" text="Đặt Lại Tài Khoản Test" class="btn-danger" style="width: 100%; margin-top: 4px; display: none;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
