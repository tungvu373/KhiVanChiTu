<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../USS/LightXianxiaTheme.uss" />

    <!-- AFK Tinh Toa Dim Veil -->
    <ui:VisualElement name="afk-dim-veil" picking-mode="Ignore" class="full-screen" style="display: none; background-color: rgba(232, 246, 238, 0.38); align-items: center; justify-content: flex-end; padding-bottom: 92px;">
        <ui:VisualElement picking-mode="Ignore" class="pill-light" style="padding: 8px 16px;">
            <ui:Label picking-mode="Ignore" text="Chế Độ Tĩnh Tọa AFK (15 FPS) — Đang cày 24/7 tiết kiệm pin" class="text-section" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Zone 1: Grand Top-Center Banner Stack (Major Events: cleanly below Stage Pill, hidden over open Drawers) -->
    <ui:VisualElement name="toast-container" picking-mode="Ignore" class="full-screen toast-container-host">
        <ui:VisualElement name="toast-stack" picking-mode="Ignore" class="toast-stack" />
    </ui:VisualElement>

    <!-- Zone 2: Compact Combat & Rare Loot Ticker above Bottom-Left Skills Bar (auto-hidden when Drawer open / Mini-Mode) -->
    <ui:VisualElement name="combat-ticker-layer" picking-mode="Ignore" class="full-screen">
        <ui:VisualElement name="combat-ticker-stack" picking-mode="Ignore" class="combat-ticker-stack" />
    </ui:VisualElement>

    <!-- Daylight Loading Overlay -->
    <ui:VisualElement name="loading-overlay" class="full-screen" style="display: none; background-color: #E7F5FF; align-items: center; justify-content: center; padding: 24px;">
        <ui:VisualElement name="loading-bg-art" class="full-screen art-slot art-slot-cover" style="opacity: 0.45;" />
        <ui:VisualElement class="panel-light" style="width: 360px; max-width: 92%; padding: 22px; align-items: center;">
            <ui:Label text="KHÍ VẬN CHI TỬ" class="text-title" style="font-size: 32px; letter-spacing: 0.8px;" />
            <ui:Label text="Thiên Địa Linh Khí" class="font-ornament" style="font-size: 28px; color: #9A6814; margin-top: -1px;" />
            <ui:Label name="loading-status-label" text="Đang tải cảnh giới..." class="text-muted" style="margin-top: 5px; font-size: 12.5px;" />
            <ui:VisualElement class="bar-track" style="width: 100%; height: 12px; margin-top: 14px; border-width: 1px; border-color: rgba(34,136,111,0.3);">
                <ui:VisualElement name="loading-progress-fill" class="bar-fill-tuvi" style="width: 10%; background-color: #22886F;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Desktop / Fallback Vietnamese Input Modal -->
    <ui:VisualElement name="desktop-input-modal" class="drawer-backdrop" style="display: none;">
        <ui:VisualElement class="panel-light" style="width: 340px; max-width: 92%; padding: 16px;">
            <ui:Label name="desktop-input-title" text="Nhập Đạo Hiệu" class="text-section" />
            <ui:TextField name="desktop-input-field" style="margin-top: 10px; height: 36px; background-color: #FFFFFF;" />
            <ui:VisualElement style="flex-direction: row; justify-content: flex-end; margin-top: 12px;">
                <ui:Button name="btn-desktop-input-cancel" text="Hủy" class="btn-secondary" style="margin-right: 8px;" />
                <ui:Button name="btn-desktop-input-ok" text="Xác nhận" class="btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
